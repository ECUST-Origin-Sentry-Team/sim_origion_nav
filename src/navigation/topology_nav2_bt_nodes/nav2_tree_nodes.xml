<?xml version="1.0"?>
<root>
  <TreeNodesModel>
    <Action ID="QueryTopologyRoute">
      <input_port name="goal">Final goal from Nav2</input_port>
      <input_port name="service_name">Topology query service name</input_port>
      <input_port name="global_frame">Global frame id</input_port>
      <input_port name="robot_base_frame">Robot base frame id</input_port>
      <input_port name="transaction_active">Freeze route outputs while a connector transaction is active</input_port>
      <output_port name="final_goal">Final navigation goal</output_port>
      <output_port name="wait_pose">Computed wait pose before connector action</output_port>
      <output_port name="connector_pose">Connector center pose</output_port>
      <output_port name="exit_pose">Computed exit pose after connector traversal</output_port>
      <output_port name="connector_id">Connector id</output_port>
      <output_port name="action_type">Connector action type</output_port>
      <output_port name="from_region">Approach region</output_port>
      <output_port name="to_region">Target region</output_port>
      <output_port name="down_timeout">Timeout waiting for robot head down done</output_port>
      <output_port name="up_monitor_timeout">Timeout monitoring robot head up done</output_port>
      <output_port name="cancel_policy">Connector cancel policy</output_port>
      <output_port name="need_action">Whether the route needs an action</output_port>
    </Action>

    <Condition ID="IsConnectorActionRequired">
      <input_port name="need_action">Whether the route needs an action</input_port>
    </Condition>

    <Action ID="SetConnectorStage">
      <input_port name="stage">Connector transaction stage name</input_port>
      <input_port name="yield_once">Return RUNNING once after setting the stage</input_port>
      <output_port name="connector_stage">Current connector transaction stage</output_port>
    </Action>

    <Action ID="SetHeadCommand">
      <input_port name="service_name">Connector action manager service</input_port>
      <input_port name="down">Whether /head/down_cmd should be true</input_port>
    </Action>

    <Decorator ID="ConnectorTransactionGuard">
      <input_port name="service_name">Connector action manager service</input_port>
      <input_port name="session_id">Connector traversal session id</input_port>
      <input_port name="action_type">Connector action type</input_port>
      <input_port name="connector_id">Connector id</input_port>
      <input_port name="goal">Current NavigateToPose goal</input_port>
      <input_port name="connector_pose">Connector center pose</input_port>
      <input_port name="wait_pose">Holding pose while waiting for robot head down done</input_port>
      <input_port name="exit_pose">Exit pose after connector traversal</input_port>
      <input_port name="cancel_policy">Connector cancel policy used for ordinary halt/failure</input_port>
      <input_port name="preempt_cancel_policy">Connector cancel policy used when a new goal preempts an active connector transaction</input_port>
      <input_port name="connector_stage">Current connector transaction stage</input_port>
      <output_port name="transaction_active">True while the wrapped connector transaction is active</output_port>
    </Decorator>

    <Action ID="ExecuteConnectorAction">
      <input_port name="service_name">Connector action manager service</input_port>
      <input_port name="session_id">Connector traversal session id</input_port>
      <input_port name="phase">Connector traversal phase</input_port>
      <input_port name="action_type">Connector action type</input_port>
      <input_port name="connector_id">Connector id</input_port>
      <input_port name="goal">Current NavigateToPose goal</input_port>
      <input_port name="connector_pose">Connector center pose</input_port>
      <input_port name="wait_pose">Holding pose while waiting for robot head down done</input_port>
      <input_port name="exit_pose">Exit pose after connector traversal</input_port>
      <input_port name="timeout">Phase timeout</input_port>
      <input_port name="cancel_policy">Connector cancel policy</input_port>
    </Action>

    <Action ID="IsHeadState">
      <input_port name="expected_state">Expected head state</input_port>
    </Action>
  </TreeNodesModel>
</root>
