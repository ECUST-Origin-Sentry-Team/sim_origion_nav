<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>simulated_obstacle_gui</name>
  <version>1.0.0</version>
  <description>Qt input panel for a topic-controlled circular Nav2 obstacle.</description>
  <maintainer email="maintainer@example.com">Origin Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <depend>geometry_msgs</depend>
  <depend>python_qt_binding</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
